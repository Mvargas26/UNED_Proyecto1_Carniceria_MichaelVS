@* ------------------------------------------------------------------------------*@
@using Modelos.Entidades
@using Modelos.Enums.Helpers
@model List<Producto>
@* ------------------------------------------------------------------------------*@

@{
    ViewData["Title"] = "Productos";
}

@section Styles {
    <link rel="stylesheet" href="~/css/Producto/listarProducto.css" asp-append-version="true" />
}

<div class="page-header">
    <div>
        <h1>Productos</h1>
        <p>Listado del inventario de productos registrados en el sistema.</p>
        <br/>
        <a asp-action="RegistrarProducto" class="btn btn-primary">
        <i class="bi bi-plus-lg me-1"></i> Registrar Producto
        </a>
    </div>

    <a asp-action="BuscarProducto" class="btn btn-secondary">
        <i class="bi bi-search"></i> Buscar Producto
    </a>
</div>

@if (!Model.Any())
{
    <div class="empty-state">
        <i class="bi bi-basket"></i>
        <h3>No hay productos registrados</h3>
        <p>Comienza registrando el primer producto.</p>
    </div>
}
else
{
    <div class="table-wrapper">
        <table class="table">
            <thead>
                <tr>
                    <th>Código</th>
                    <th>Nombre</th>
                    <th>Categoría</th>
                    <th>Unidad de Medida</th>
                    <th>Precio</th>
                    <th>Existencia Actual</th>
                    <th>Existencia Mínima</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var producto in Model)
                {
                    bool existenciaBaja = producto.ExistenciaActual <= producto.ExistenciaMinima;
                    <tr class="@(existenciaBaja ? "fila-advertencia" : "")">
                        <td>@producto.CodigoProducto</td>
                        <td>@producto.NombreProducto</td>
                        <td>@producto.Categoria.ObtenerNombreVisible()</td>
                        <td>@producto.UnidadMedida.ObtenerNombreVisible()</td>
                        <td>@producto.PrecioPorUnidadMedida.ToString("C2")</td>
                        <td>
                            @producto.ExistenciaActual
                            @if (existenciaBaja)
                            {
                                <i class="bi bi-exclamation-triangle-fill text-danger ms-1" title="Existencia baja"></i>
                            }
                        </td>
                        <td>@producto.ExistenciaMinima</td>
                        <td class="text-end">
                            <a asp-action="EditarProducto" asp-route-id="@producto.Id" class="btn btn-sm btn-icon btn-edit" title="Editar">
                                <i class="bi bi-pencil"></i>
                            </a>

                            <form asp-action="EliminarProducto" asp-route-id="@producto.Id" method="post"
                                  onsubmit="return confirm('¿Está seguro que desea eliminar el producto @producto.NombreProducto?');"
                                  style="display:inline;">
                                <button type="submit" class="btn btn-sm btn-icon btn-delete" title="Eliminar">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}