@* ------------------------------------------------------------------------------*@
@using Modelos.Entidades
@model List<Cliente>
@* ------------------------------------------------------------------------------*@

@{
    ViewData["Title"] = "Clientes";
}

@section Styles {
    <link rel="stylesheet" href="~/css/Cliente/listar.css" asp-append-version="true" />
}

<div class="page-header">
    <div>
        <h1>Clientes</h1>
        <p>Listado de clientes registrados en el sistema.</p>
    </div>
    <a asp-action="RegistrarCliente" class="btn btn-primary">
        <i class="bi bi-plus-lg me-1"></i> Registrar Cliente
    </a>
</div>

@if (!Model.Any())
{
    <div class="empty-state">
        <i class="bi bi-people"></i>
        <h3>No hay clientes registrados</h3>
        <p>Comienza registrando el primer cliente.</p>
    </div>
}
else
{
    <div class="table-wrapper">
        <table class="table">
            <thead>
                <tr>
                    <th>Identificación</th>
                    <th>Nombre</th>
                    <th>Primer Apellido</th>
                    <th>Segundo Apellido</th>
                    <th>Fecha de Nacimiento</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var cliente in Model)
                {
                    <tr>
                        <td>@cliente.Identificacion</td>
                        <td>@cliente.Nombre</td>
                        <td>@cliente.PrimerApellido</td>
                        <td>@cliente.SegundoApellido</td>
                        <td>@cliente.FechaNacimiento.ToString("dd/MM/yyyy")</td>
                        <td class="text-end">
                            <a asp-action="EditarCliente" asp-route-id="@cliente.Id" class="btn btn-sm btn-icon btn-edit" title="Editar">
                                <i class="bi bi-pencil"></i>
                            </a>
                            <a asp-action="Eliminar" asp-route-id="@cliente.Id" class="btn btn-sm btn-icon btn-delete" title="Eliminar">
                                <i class="bi bi-trash"></i>
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}